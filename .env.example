# Application
APP_URL=http://localhost:8080
BRAND_NAME=Nomen
BRAND_LOGO=/assets/brand/nomen-icon.svg
# Footer copyright line. Leave empty to hide it.
BRAND_COPYRIGHT=
# Policy pages and support label. Leave empty to hide the links.
BRAND_PRIVACY_URL=
BRAND_TERMS_URL=
BRAND_DEVELOPER_GUIDELINES_URL=
BRAND_SUPPORT_NAME=
DEFAULT_SKIN=nomen-2026

# Required. Part of every password hash -- changing it after launch locks out every user.
APP_PEPPER=replace-with-a-long-random-string
APP_SECRET=replace-with-a-random-string

# Debug mode. When on, error pages show exception details and stack traces.
# Never enable on a public site -- the details can reveal paths and internals.
APP_DEBUG=0

# Database
# mysql / mariadb / sqlite. SQLite uses DB_PATH only; the other fields are ignored.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nomen
DB_USER=nomen
DB_PASS=
DB_PATH=database/nomen.sqlite

# Redis (optional: rate limiting and killing other sessions)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nomen

# Contacts
SUPPORT_EMAIL=
ADMIN_NOTIFY_EMAIL=

# Optional features (default off)
# guardians  family / minor guardian consent, guardian email, family page
# country    ask for country/region at signup (also enables IP-based prefill)
FEATURE_GUARDIANS=0
FEATURE_COUNTRY=0
