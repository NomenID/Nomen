 * Project: https://nomenid.org/
 */

require __DIR__ . '/../src/bootstrap.php';

$args = $_SERVER['argv'];
$cmd = $args[1] ?? 'help';

switch ($cmd) {
    case 'install':
        exit(Nomen\Src\Cli\Install::run(array_slice($args, 2)));

    case 'migrate':
        exit(Nomen\Src\Cli\Migrate::run(array_slice($args, 2)));

    case 'upgrade':
        exit(Nomen\Src\Cli\Upgrade::run(array_slice($args, 2)));

    case 'plugins':
        exit(Nomen\Src\Cli\Plugin::run(array_slice($args, 2)));

    case 'auth:reset':
        exit(Nomen\Src\Cli\AuthReset::run(array_slice($args, 2)));

    case 'user:passwd':
    case 'user:promote':
    case 'user:demote':
        exit(Nomen\Src\Cli\User::run(array_merge([substr($cmd, 5)], array_slice($args, 2))));

    case 'doctor':
        exit(Nomen\Src\Cli\Doctor::run(array_slice($args, 2)));

    case 'backup':
        exit(Nomen\Src\Cli\Backup::run(array_slice($args, 2)));

    case 'restore':
        exit(Nomen\Src\Cli\Backup::restore(array_slice($args, 2)));

    case 'help':
    case '--help':
    case '-h':
        echo '用法：php bin/nomen <命令>', PHP_EOL, PHP_EOL;
        echo '  install          交互式安装：建库、导表、建管理员、写 .env', PHP_EOL;
        echo '  upgrade          覆盖新版本文件之后跑：核心迁移 + 插件迁移', PHP_EOL;
        echo '  migrate          应用 database/migrations 下还没跑过的 SQL', PHP_EOL;
        echo '  plugins list     列出插件与启用状态', PHP_EOL;
        echo '  plugins migrate  跑插件自己的 database/migrations', PHP_EOL;
        echo '  plugins <命令>   跑插件注册的命令，plugins list 里能看到', PHP_EOL;
        echo '  auth:reset       登录方式全关进不去后台时用：恢复默认（全部开启）', PHP_EOL;
        echo '  user:passwd <账号>   直接改密码（忘了管理员密码、发不出邮件时用），令牌一起撤销', PHP_EOL;
        echo '  user:promote <账号>  把账号提成管理员', PHP_EOL;
        echo '  user:demote <账号>   把管理员降回普通用户', PHP_EOL;
        echo '  doctor           自检：扩展、目录可写、配置、数据库连接、待应用迁移', PHP_EOL;
        echo '  backup [目录]    备份数据库（默认 data/backups）', PHP_EOL;
        echo '  restore <文件>   从备份恢复，--yes 跳过确认；恢复前会自动备份当前库', PHP_EOL;
        exit(0);

    default:
        fwrite(STDERR, '未知命令：' . $cmd . '（php bin/nomen help）' . PHP_EOL);
        exit(1);
}
